.47 158.53Z" fill="#0000FF" stroke="var(--bg)" stroke-width="1.2"/><path d="M60.79 147.22A82 82 0 0 1 60.79 104.78L95.57 114.09A46 46 0 0 0 95.57 137.91Z" fill="#8000FF" stroke="var(--bg)" stroke-width="1.2"/><path d="M60.79 104.78A82 82 0 0 1 82.02 68.02L107.47 93.47A46 46 0 0 0 95.57 114.09Z" fill="#FF00FF" stroke="var(--bg)" stroke-width="1.2"/><path d="M82.02 68.02A82 82 0 0 1 118.78 46.79L128.09 81.57A46 46 0 0 0 107.47 93.47Z" fill="#FF0080" stroke="var(--bg)" stroke-width="1.2"/><line x1="140" y1="82" x2="140" y2="170" stroke="var(--fg)" stroke-width="1.6"/><circle cx="140" cy="82" r="3.4" fill="var(--fg)"/><circle cx="140" cy="170" r="3.4" fill="var(--fg)"/><line x1="178.11" y1="104" x2="101.89" y2="148" stroke="var(--fg)" stroke-width="1.6" stroke-dasharray="4 3"/><circle cx="178.11" cy="104" r="3.4" fill="var(--fg)"/><circle cx="101.89" cy="148" r="3.4" fill="var(--fg)"/><text x="140" y="36" text-anchor="middle" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">RED</text><text x="217.94" y="81" text-anchor="start" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">YELLOW</text><text x="217.94" y="171" text-anchor="start" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">GREEN</text><text x="140" y="216" text-anchor="middle" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">CYAN</text><text x="62.06" y="171" text-anchor="end" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">BLUE</text><text x="62.06" y="81" text-anchor="end" dominant-baseline="middle" font-size="11" letter-spacing=".3" fill="var(--fg)">MAGENTA</text><text x="140" y="246" text-anchor="middle" font-size="12.5" font-weight="500" fill="var(--fg)">sRGB / HSV &mdash; screen</text><text x="140" y="262" text-anchor="middle" font-size="10.5" fill="var(--muted)">secondaries: cyan, magenta, yellow</text></svg><div style="margin-top:.45rem;font-size:.82rem;line-height:1.5;color:var(--fg);">red &harr; cyan<br><span style="opacity:.7">yellow &harr; blue (dashed)</span></div></div></div><figcaption style="margin-top:.7rem;font-size:.85rem;line-height:1.55;color:var(--muted);">The same twelve-position wheel, two conventions, drawn to the same geometry so they can be read against each other. Left: RYB, where the secondaries are <b>orange, green, purple</b> &mdash; what mixing paint gives. Right: the screen wheel, exact 30&deg; HSV steps at full saturation and value, where the secondaries are the real additive ones, <b>cyan, magenta, yellow</b>. The hues do not even land in the same places: yellow sits a third of the way round on the left and a sixth of the way round on the right. So the marked chords disagree &mdash; red opposes <b>green</b> in RYB but <b>cyan</b> on screen; yellow opposes <b>purple</b> in RYB but <b>blue</b> on screen. Both are internally consistent; neither is the other&rsquo;s approximation.</figcaption></figure>
